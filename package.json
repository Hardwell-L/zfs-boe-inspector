{
  "name": "zfs-boe-inspector",
  "version": "0.1.1",
  "private": true,
  "description": "ZFS BOE 运行时检查与差旅标准诊断工具",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hardwell-L/zfs-boe-inspector.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' build",
    "dev": "pnpm --filter @zfs-boe-inspector/extension dev",
    "lint": "eslint .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "release:check": "node scripts/check-release.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.1.38",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.3.0"
  }
}
